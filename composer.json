{
    "name": "eloquage/tokens-ext",
    "description": "Optional PIE-compatible TypePHP native extension for eloquage/tokens.",
    "type": "php-ext",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "php-ext": {
      "extension-name": "eloquage_tokens",
      "download-url-method": ["pre-packaged-binary"],
      "support-zts": false,
      "support-nts": true,
      "os-families": ["linux"]
    },
    "homepage": "https://github.com/eloquage/tokens-ext",
    "support": {
        "source": "https://github.com/eloquage/tokens-ext"
    }
}
